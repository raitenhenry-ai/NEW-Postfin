# ---- Core ----
# Public URL of this deployment (no trailing slash). Must be reachable from
# the internet for OAuth callbacks and for platforms fetching the video.
BASE_URL=https://your-domain.example
PORT=3000

# Login password. Empty = no auth (local use only).
ADMIN_PASSWORD=

# Postgres connection string; empty = local SQLite in data/app.db.
# The app creates its tables, migrations and indexes on boot - nothing to
# run first. SSL is automatic for any non-localhost host.
#
# Neon (use the pooled endpoint, the host containing "-pooler"):
#   postgresql://<user>:<pw>@ep-<id>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#
# Supabase: use the Session pooler string from Settings > Database. The
# direct db.<ref>.supabase.co host is IPv6-only without the add-on and most
# hosts cannot reach it. On Supabase, also run supabase.sql once - it stops
# the anon API exposing your stored OAuth tokens. See the README.
DATABASE_URL=

# ---- AI generation ----
# Script writing + text-to-speech voiceover for the built-in renderer.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- Video format ----
# avatar    = a person talking to camera. Rendered by Grok Imagine when
#             XAI_API_KEY is set (preferred), or HeyGen otherwise.
# slideshow = the built-in renderer: AI slide art, one big line of text per
#             slide, a voiceover, cut together with ffmpeg. This is the format
#             software, apps and comparison ads are made in, and it needs no
#             HeyGen account - just OPENAI_API_KEY and ffmpeg on PATH.
# Set per video from the calendar assistant; this is only the default.
UGC_FORMAT=avatar

# Grok Imagine (xAI) video generation. When the key is set, non-slideshow
# videos render with Grok: the whole clip - creator, room, camera work,
# voice - is generated in one shot from the script, with the product's real
# photos passed as reference images. The key is at console.x.ai.
XAI_API_KEY=
# GROK_VIDEO_MODEL=grok-imagine-video-1.5
# Up to 15 (the API's ceiling).
# GROK_VIDEO_SECONDS=15
# 480p / 720p / 1080p. Videos with product reference images cap at 720p.
# GROK_VIDEO_RESOLUTION=720p
# Optional preset voice (e.g. eve) so the creator sounds the same every video.
# GROK_VOICE_ID=
# Pin the renderer instead of auto-picking: grok or heygen.
# UGC_VIDEO_PROVIDER=

# HeyGen avatar videos. The key is under Settings > API in HeyGen; API access
# needs a paid plan, and every render spends HeyGen credits.
HEYGEN_API_KEY=

# Which avatar and voice to use when a video does not specify one. Leave
# these EMPTY and the renderer uses the first avatar this account actually
# has - safer than naming an id, since HeyGen retires stock avatars and a
# missing one fails the render with "avatar not found". The create form
# lists what this account owns, so you normally pick there.
# HEYGEN_AVATAR_ID=
# HEYGEN_VOICE_ID=
# HEYGEN_BACKGROUND=#0b0d12
# HEYGEN_SPEED=1.05

# ---- Slideshow renderer ----
# Slide art comes from OpenAI's image model at 1024x1536. Quality drives look
# and cost: a six-slide ad is about $0.10 at low, $0.38 at medium, $1.50 at
# high. A slide whose image fails becomes a gradient card rather than failing
# the video.
# Note: gpt-image-1 needs your OpenAI organisation to be VERIFIED (Settings >
# Organization > General). Without it the API returns 403 and slideshows fail
# with that message - check it from Profile > Generation before scheduling.
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
# How faithfully the product is recreated from its own photos on slides that
# show it. "high" holds a logo, a label or a screenshot's layout together.
# OPENAI_IMAGE_FIDELITY=high
# OPENAI_IMAGE_TIMEOUT_MS=150000
# UGC_SLIDE_COUNT=6
# UGC_SLIDE_SECONDS=3.2
# Voiceover, and the font the overlay text is burned in with. FONT_PATH is
# only needed when no system font is found.
# UGC_TTS_VOICE=nova
# UGC_TTS_MODEL=gpt-4o-mini-tts
# FONT_PATH=
# UGC_VIDEO_SECONDS=24

# ---- Analytics ----
# How often to pull view/like/comment counts from the platform APIs, and how
# long a post keeps being polled after it was published. Metrics power the
# dashboard tiles and the analytics charts; set INTERVAL to 0 to disable.
METRICS_INTERVAL_MINUTES=30
METRICS_MAX_AGE_DAYS=90

# Optional revenue estimate. No social API reports ad revenue for the posts
# we publish, so the CPM tile stays blank unless you supply your own rates
# (US dollars per 1000 views). Set a default and/or per-platform overrides.
# ESTIMATED_CPM=
# ESTIMATED_CPM_YOUTUBE=
# ESTIMATED_CPM_TIKTOK=
# ESTIMATED_CPM_INSTAGRAM=

# ---- Scheduling ----
# How often the scheduler looks for posts whose time has come.
SCHEDULER_INTERVAL_SECONDS=30

# ---- Social platform API credentials (set the ones you use) ----
# Which platforms the UI offers. All eight are implemented; only these are
# shown on Connectors, in the platform pickers and the analytics filters.
ENABLED_PLATFORMS=tiktok,instagram,youtube

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_CONFIG_ID=
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta app webhook verify token (their dashboard requires a webhook URL:
# use https://your-domain.example/webhooks/meta with this token).
META_VERIFY_TOKEN=postfin-verify

# MAX_ACCOUNTS_PER_PLATFORM=5
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
