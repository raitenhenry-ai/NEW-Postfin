# ---- Core ----
# Public URL of this deployment (no trailing slash). Must be reachable from
# the internet for OAuth callbacks and for platforms fetching the video.
BASE_URL=https://your-domain.example
PORT=3000

# Login password. Empty = no auth (local use only).
ADMIN_PASSWORD=

# Postgres connection string; empty = local SQLite in data/app.db.
# The app creates its tables, migrations and indexes on boot - nothing to
# run first. SSL is automatic for any non-localhost host.
#
# Neon (use the pooled endpoint, the host containing "-pooler"):
#   postgresql://<user>:<pw>@ep-<id>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#
# Supabase: use the Session pooler string from Settings > Database. The
# direct db.<ref>.supabase.co host is IPv6-only without the add-on and most
# hosts cannot reach it. On Supabase, also run supabase.sql once - it stops
# the anon API exposing your stored OAuth tokens. See the README.
DATABASE_URL=

# ---- AI generation ----
# Script writing + text-to-speech voiceover for the built-in renderer.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# HeyGen avatar videos. With a key set, UGC_PROVIDER=auto uses HeyGen and
# falls back to the built-in ffmpeg renderer without one. Force either with
# UGC_PROVIDER: auto | heygen | local.
# The key is under Settings > API in HeyGen; API access needs a paid plan,
# and every render spends HeyGen credits.
HEYGEN_API_KEY=
UGC_PROVIDER=auto

# Which avatar and voice to use when a video does not specify one. The
# create form lists whatever this account actually has, so you normally pick
# there rather than setting these. Check the key works from the Profile page.
# HEYGEN_AVATAR_ID=
# HEYGEN_VOICE_ID=
# HEYGEN_BACKGROUND=#0b0d12
# HEYGEN_SPEED=1.05

# Built-in renderer voiceover settings (ignored when HeyGen is used).
# UGC_TTS_VOICE=nova
# UGC_VIDEO_SECONDS=24

# ---- Analytics ----
# How often to pull view/like/comment counts from the platform APIs, and how
# long a post keeps being polled after it was published. Metrics power the
# dashboard tiles and the analytics charts; set INTERVAL to 0 to disable.
METRICS_INTERVAL_MINUTES=30
METRICS_MAX_AGE_DAYS=90

# Optional revenue estimate. No social API reports ad revenue for the posts
# we publish, so the CPM tile stays blank unless you supply your own rates
# (US dollars per 1000 views). Set a default and/or per-platform overrides.
# ESTIMATED_CPM=
# ESTIMATED_CPM_YOUTUBE=
# ESTIMATED_CPM_TIKTOK=
# ESTIMATED_CPM_INSTAGRAM=

# ---- Scheduling ----
# How often the scheduler looks for posts whose time has come.
SCHEDULER_INTERVAL_SECONDS=30

# ---- Social platform API credentials (set the ones you use) ----
# Which platforms the UI offers. All eight are implemented; only these are
# shown on Connectors, in the platform pickers and the analytics filters.
ENABLED_PLATFORMS=tiktok,instagram,youtube

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_CONFIG_ID=
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta app webhook verify token (their dashboard requires a webhook URL:
# use https://your-domain.example/webhooks/meta with this token).
META_VERIFY_TOKEN=postfin-verify

# MAX_ACCOUNTS_PER_PLATFORM=5
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
