{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/auto-push.sh",
        "timeout": 180
      }
    ],
    "afterTabFileEdit": [
      {
        "command": ".cursor/hooks/auto-push.sh",
        "timeout": 180
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/auto-push.sh",
        "timeout": 180
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/auto-push.sh",
        "timeout": 180
      }
    ]
  }
}
